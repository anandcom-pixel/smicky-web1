{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/deliverables",
      "destination": "/index.html"
    },
    {
      "source": "/downloads/:match*",
      "destination": "/public/downloads/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"pocket-catalog.apk\""
        }
      ]
    }
  ]
}